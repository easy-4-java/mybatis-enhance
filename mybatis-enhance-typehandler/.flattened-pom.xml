<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.easy4j</groupId>
        <artifactId>mybatis-enhance</artifactId>
        <version>3.0.x.20260630-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>mybatis-enhance-typehandler</artifactId>
    <description>通用 MyBatis TypeHandler 集合：数组/JSON/集合/Blob/Date 等 24 个类型处理器。
        纯 MyBatis 依赖（零 Spring、零 MyBatis-Plus），供 mybatis-enhance、mybatis-plus-enhance、ddd4j 等项目共享复用。
    </description>

    <dependencies>
        <!-- MyBatis 核心 -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
        </dependency>
        <!-- FastJSON2（FastJsonTypeHandler / FastJsonArrayTypeHandler） -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>
        <!-- Jackson（MyJacksonTypeHandler / ListTypeHandler / JsonStringTypeHandler） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <!-- Hutool（JsonTypeHandler / JsonArrayTypeHandler / ListStringTypeHandler / SetStringTypeHandler） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <!-- Commons Lang3（BaseTypeHandler 的 StringUtils） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- TypeHandler 是可跨 MyBatis/MyBatis-Plus 项目复用的纯 MyBatis 组件，不绑定任何集成框架。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-framework-integration-dependencies</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>org.springframework.*:*</exclude>
                                        <exclude>org.mybatis:mybatis-spring</exclude>
                                        <exclude>com.baomidou:*</exclude>
                                    </excludes>
                                    <message>mybatis-enhance-typehandler 必须保持纯 MyBatis，禁止引入 Spring 或
                                        MyBatis-Plus。
                                    </message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
